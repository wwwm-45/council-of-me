# Unified LLM configuration for this project.
# Copy this file to `.env` and replace each placeholder with a real value.

LLM_PROVIDER=openai
LLM_MODEL=deepseek-chat
LLM_WIRE_API=chat_completions
# Output-token ceiling for calls that omit max_tokens. Stay at/below the
# provider's per-request cap (DeepSeek official: 8192).
LLM_MAX_TOKENS_DEFAULT=4096

# OpenAI / OpenAI-compatible relay
LLM_API_KEY=__REPLACE_WITH_OPENAI_COMPATIBLE_API_KEY__
LLM_BASE_URL=__REPLACE_WITH_OPENAI_COMPATIBLE_BASE_URL__

# Claude relay
CLAUDE_BASE_URL=__REPLACE_WITH_CLAUDE_BASE_URL__

# Bailian / DashScope relay
QWEN_API_KEY=__REPLACE_WITH_QWEN_API_KEY__
QWEN_BASE_URL=__REPLACE_WITH_QWEN_BASE_URL__

# DeepSeek official API (first-party, OpenAI-compatible)
DEEPSEEK_API_KEY=__REPLACE_WITH_DEEPSEEK_API_KEY__
DEEPSEEK_BASE_URL=https://api.deepseek.com
